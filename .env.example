# Copia este archivo como .env y llena los valores.
# Todo lo que empieza por EXPO_PUBLIC_ queda dentro de la app: aquí nunca va un secreto.

# Firebase: Configuración del proyecto > Tus apps > app web > firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary: Settings > Upload > Upload presets. El preset es sin firma (Unsigned),
# así que no hay secreto: el nombre del preset limita carpeta y formato.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Servicios: URL del backend y servidor de rutas OSRM. Sin EXPO_PUBLIC_OSRM_URL
# uso el servidor público.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org