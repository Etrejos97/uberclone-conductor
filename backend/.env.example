# Copia este archivo como .env y llena los valores. El .env nunca sube a Git.

# Mercado Pago: Tus integraciones > tu aplicación > Credenciales de prueba > Access Token.
MP_ACCESS_TOKEN=

# Firebase: Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Es el JSON completo en una sola línea.
FIREBASE_SERVICE_ACCOUNT=

# La URL pública del backend en Render, con https. Sin ella el backend funciona, pero
# Mercado Pago no tiene a dónde avisar: el pago se confirma con "Verificar pago".
PUBLIC_BASE_URL=

# Render pone su propio puerto. En el PC uso este.
PORT=3000